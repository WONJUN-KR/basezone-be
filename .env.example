DB_URL=jdbc:postgresql://localhost:5450/ballpark
DB_USER=ballpark
DB_PASSWORD=
PORT=8090
# 로그인 (32바이트 이상 무작위 문자열)
JWT_SECRET=
KAKAO_APP_ID=
# 여러 개면 쉼표로 (iOS · Android · 웹 클라이언트 ID)
GOOGLE_CLIENT_IDS=
# iOS 번들 ID (웹 로그인을 쓰면 서비스 ID 도)
APPLE_CLIENT_IDS=
# 로컬 개발 전용: true 면 소셜 토큰 확인 없이 로그인. 운영에서 켜지 말 것
AUTH_FAKE_SOCIAL=false
